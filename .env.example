# Zkopíruj jako .env a vyplň. Stačí jeden kanál, víc jich nevadí.

# Přístup k dashboardu – dlouhý náhodný řetězec. Vygeneruješ ho příkazem:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASH_TOKEN=

# Adresa dashboardu i s tokenem – otevře se po klepnutí na upozornění.
# Příklad: https://hlidac.example.cz/?k=TVUJ_TOKEN
DASHBOARD_URL=

# Pushover – doporučeno pro iPhone (kritická upozornění projdou i přes Nerušit a ztlumení).
# PUSHOVER_USER = „Your User Key“ na pushover.net, PUSHOVER_TOKEN = token aplikace, kterou si tam vytvoříš.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Telegram – zdarma. Token dá @BotFather, chat ID zjistíš po napsání botovi na
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy – vhodné pro Android nebo jako záloha. Téma = dlouhý tajný název.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Hlídání hlídače: healthchecks.io (zdarma) ti dá vědět, když hlídač přestane běžet.
HEALTHCHECK_URL=

# Volitelné klíče zdrojů (registrace zdarma)
#TANKERKOENIG_KEY=
#AGSI_KEY=
